# Database
# Used on the host (pnpm prisma ..., pnpm dev outside Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/naukari360
# Used by the compose containers instead (host.docker.internal = the host)
DOCKER_DATABASE_URL=postgresql://user:password@host.docker.internal:5432/naukari360

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (optional for dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OneSignal (optional for dev)
ONESIGNAL_APP_ID=

# Resend (optional for dev)
RESEND_API_KEY=

# Admin
ADMIN_EMAIL=admin@naukari360.in

# Machine ingestion (e.g. the Agentry-One govt-job-agent) -- posts created via
# /api/ingest/posts always land as drafts. Generate with: openssl rand -base64 32
INGEST_API_KEY=
