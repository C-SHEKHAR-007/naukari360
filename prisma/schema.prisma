generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  draft
  published
  archived
}

enum PostBadge {
  NEW
  HOT
  TRENDING
  EXPIRED
  IMPORTANT
}

enum QualificationLevel {
  tenth
  twelfth
  graduate
  post_graduate
  any
}

enum AdminRole {
  super_admin
  editor
}

enum ContactType {
  general
  sponsored_post
  advertisement
}

enum SettingType {
  text
  html
  boolean
  json
}

model Post {
  id                String             @id @default(uuid())
  titleEn           String             @map("title_en")
  titleHi           String?            @map("title_hi")
  slug              String             @unique
  contentEn         String?            @map("content_en")
  contentHi         String?            @map("content_hi")
  excerptEn         String?            @map("excerpt_en")
  excerptHi         String?            @map("excerpt_hi")
  categoryId        String?            @map("category_id")
  stateId           String?            @map("state_id")
  status            PostStatus         @default(draft)
  badge             PostBadge?
  totalPosts        String?            @map("total_posts")
  organization      String?
  qualification     String?
  qualificationLevel QualificationLevel? @map("qualification_level")
  minAge            Int?               @map("min_age")
  maxAge            Int?               @map("max_age")
  ageLimit          String?            @map("age_limit")
  salary            String?
  feeGeneral        String?            @map("fee_general")
  feeObc            String?            @map("fee_obc")
  feeScSt           String?            @map("fee_sc_st")
  feeWomen          String?            @map("fee_women")
  lastDate          DateTime?          @map("last_date")
  examDate          DateTime?          @map("exam_date")
  resultDate        DateTime?          @map("result_date")
  applyLink         String?            @map("apply_link")
  officialLink      String?            @map("official_link")
  notificationLink  String?            @map("notification_link")
  admitCardLink     String?            @map("admit_card_link")
  answerKeyLink     String?            @map("answer_key_link")
  syllabusLink      String?            @map("syllabus_link")
  isTrending        Boolean            @default(false) @map("is_trending")
  isHot             Boolean            @default(false) @map("is_hot")
  isNew             Boolean            @default(true) @map("is_new")
  metaTitle         String?            @map("meta_title")
  metaDesc          String?            @map("meta_desc")
  metaKeywords      String?            @map("meta_keywords")
  ogImage           String?            @map("og_image")
  readingTime       Int?               @map("reading_time")
  views             Int                @default(0)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  category          Category?          @relation(fields: [categoryId], references: [id])
  state             State?             @relation(fields: [stateId], references: [id])
  importantDates    ImportantDate[]
  faqs              Faq[]
  postTags          PostTag[]
  bookmarks         Bookmark[]
  applications      ApplicationTracker[]

  @@index([status])
  @@index([categoryId])
  @@index([stateId])
  @@index([lastDate])
  @@index([examDate])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, categoryId])
  @@index([status, stateId])
  @@map("posts")
}

model ImportantDate {
  id           String @id @default(uuid())
  postId       String @map("post_id")
  labelEn      String @map("label_en")
  labelHi      String? @map("label_hi")
  date         String
  displayOrder Int    @default(0) @map("display_order")

  post         Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("important_dates")
}

model Category {
  id           String  @id @default(uuid())
  name         String
  nameHi       String? @map("name_hi")
  slug         String  @unique
  icon         String?
  color        String?
  description  String?
  metaTitle    String? @map("meta_title")
  metaDesc     String? @map("meta_desc")
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  posts        Post[]
  affiliateLinks AffiliateLink[]

  @@map("categories")
}

model Tag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  postTags PostTag[]

  @@map("tags")
}

model PostTag {
  postId String @map("post_id")
  tagId  String @map("tag_id")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model State {
  id       String  @id @default(uuid())
  name     String
  nameHi   String? @map("name_hi")
  slug     String  @unique
  isActive Boolean @default(true) @map("is_active")

  posts    Post[]

  @@map("states")
}

model Faq {
  id           String @id @default(uuid())
  postId       String @map("post_id")
  questionEn   String @map("question_en")
  questionHi   String? @map("question_hi")
  answerEn     String @map("answer_en")
  answerHi     String? @map("answer_hi")
  displayOrder Int    @default(0) @map("display_order")

  post         Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("faqs")
}

model SiteSetting {
  key   String      @id
  value String
  type  SettingType @default(text)

  @@map("site_settings")
}

model AdSlot {
  id         String   @id @default(uuid())
  name       String
  slotKey    String   @unique @map("slot_key")
  adCode     String?  @map("ad_code")
  isActive   Boolean  @default(false) @map("is_active")
  device     String   @default("all")
  popupDelay Int?     @map("popup_delay")
  startDate  DateTime? @map("start_date")
  endDate    DateTime? @map("end_date")
  notes      String?

  @@map("ad_slots")
}

model Banner {
  id           String  @id @default(uuid())
  title        String
  imageUrl     String  @map("image_url")
  link         String?
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  @@map("banners")
}

model Announcement {
  id           String  @id @default(uuid())
  text         String
  link         String?
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  @@map("announcements")
}

model NavMenu {
  id           String   @id @default(uuid())
  label        String
  labelHi      String?  @map("label_hi")
  url          String
  parentId     String?  @map("parent_id")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")

  parent       NavMenu? @relation("MenuHierarchy", fields: [parentId], references: [id])
  children     NavMenu[] @relation("MenuHierarchy")

  @@map("nav_menus")
}

model Page {
  id        String @id @default(uuid())
  titleEn   String @map("title_en")
  titleHi   String? @map("title_hi")
  slug      String @unique
  contentEn String? @map("content_en")
  contentHi String? @map("content_hi")
  metaTitle String? @map("meta_title")
  metaDesc  String? @map("meta_desc")

  @@map("pages")
}

model Admin {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      AdminRole @default(editor)
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("admins")
}

model Notification {
  id      String   @id @default(uuid())
  title   String
  message String
  link    String?
  sentAt  DateTime @default(now()) @map("sent_at")

  @@map("notifications")
}

model EmailSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  isActive     Boolean  @default(true) @map("is_active")
  source       String   @default("homepage")
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@index([isActive, subscribedAt])
  @@map("email_subscribers")
}

model AffiliateLink {
  id             String   @id @default(uuid())
  name           String
  originalUrl    String   @map("original_url")
  slug           String   @unique
  clicks         Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  displayInPosts Boolean  @default(false) @map("display_in_posts")
  categoryId     String?  @map("category_id")
  createdAt      DateTime @default(now()) @map("created_at")

  category       Category? @relation(fields: [categoryId], references: [id])

  @@map("affiliate_links")
}

model InterstitialPage {
  id           String  @id @default(uuid())
  title        String
  adSlotKey    String  @map("ad_slot_key")
  delaySeconds Int     @default(5) @map("delay_seconds")
  isActive     Boolean @default(true) @map("is_active")

  @@map("interstitial_pages")
}

model ContactSubmission {
  id        String      @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  type      ContactType @default(general)
  isRead    Boolean     @default(false) @map("is_read")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@map("contact_submissions")
}

model PageView {
  id     String   @id @default(uuid())
  postId String   @map("post_id")
  date   DateTime @default(now()) @db.Date
  views  Int      @default(1)

  @@unique([postId, date])
  @@index([date])
  @@map("page_views")
}

// ==========================================
// User Accounts & NextAuth Models (V2.0)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          String?   @default("user")
  accounts      Account[]
  sessions      Session[]
  bookmarks     Bookmark[]
  applications  ApplicationTracker[]
 
  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model ApplicationTracker {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  status    String   @default("interested") // interested, applied, rejected, interview
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("application_tracker")
}
